# Public ports on the Aliyun ECS host.
BLOG_HTTP_PORT=80
ADMIN_HTTP_PORT=8080
TZ=Asia/Shanghai

# MySQL. Use separate long random values for these three passwords.
MYSQL_DATABASE=blog_base
MYSQL_USER=blog_app
MYSQL_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD

# Used to sign admin JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Used only when the initial admin account is first created in an empty database.
ADMIN_INITIAL_USER=tom
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# RustFS object storage and Redis cache. The containers are deployed now;
# backend code integration is a separate application change.
RUSTFS_ACCESS_KEY=CHANGE_ME_RUSTFS_ACCESS_KEY
RUSTFS_SECRET_KEY=CHANGE_ME_RUSTFS_SECRET_KEY
RUSTFS_BUCKET=blog-files
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
